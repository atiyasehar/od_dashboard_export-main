# Copy to deploy.env and set values for YOUR machine (deploy.env is git-ignored).
# All ports, hosts, and credentials are yours to configure — nothing is fixed in the docs.
# The dashboard server and start scripts load this file automatically.

# --- HTTP server ---
PORT=
# Bind address: pass --host on the CLI if needed (default 0.0.0.0)

# --- PostgreSQL (required for restore + runtime) ---
PGHOST=
PGPORT=
PGUSER=
PGPASSWORD=
PGDATABASE=od_dashboard
PGSCHEMA=public

# --- Bundle root (auto-detected when manifest.json is in the repo root) ---
# POPGEN_BUNDLE_ROOT=.

# --- Reverse proxy / shared host (optional; leave empty for local dev) ---
DASH_URL_PREFIX=
DASH_API_PREFIX=/api
DASH_SHOW_BOUNDARY_BUTTON=false

# --- PostgreSQL client tools (optional; if pg_dump/pg_restore not on PATH) ---
# PG_BIN=

# --- Advanced: table overrides (optional; defaults match manifest.json) ---
# OD10_RUN_TAG=od10
# OD10_METRICS=weighted
# OD10_BUILDING_POPULATION_ALLOC=0
